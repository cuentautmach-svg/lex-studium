# Node 24+. Genera un hash con npm run admin:password; nunca pongas la contraseña aquí.
ADMIN_PASSWORD_HASH=
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# Producción: NODE_ENV=production y PUBLIC_ORIGIN=https://tu-dominio
NODE_ENV=development
# Almacenamiento persistente PRIVADO; en producción monta un volumen y haz copias.
DATA_DIR=./data
